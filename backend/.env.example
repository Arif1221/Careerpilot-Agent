# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model used by the agent. claude-haiku-4-5-20251001 is cheap and fast (good default for
# a student project). Swap to claude-sonnet-5 for noticeably better suggestion quality.
CAREERPILOT_MODEL=claude-haiku-4-5-20251001

# Comma-separated list of origins allowed to call this API.
# Set this to your deployed Vercel URL once you have it, e.g:
# ALLOWED_ORIGINS=https://careerpilot-ai.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
