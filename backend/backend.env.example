# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by the agent. gemini-2.5-flash is cheap and fast (good default for
# a student project). Swap to a stronger Gemini model for better suggestion quality.
CAREERPILOT_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API.
# Set this to your deployed Vercel URL once you have it, e.g:
# ALLOWED_ORIGINS=https://careerpilot-ai.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
